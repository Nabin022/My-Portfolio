# Copy this file to .env and fill in values if you wire up the contact form.

# --- Contact form (optional) ---
# The contact form ships in "demo" mode: it validates input and shows a
# success message without sending anything. To actually deliver mail, choose
# one of the options below and fill in the corresponding variables.

# Option A: Formspree (https://formspree.io) — easiest, no backend needed.
# Create a form, copy its endpoint ID, and set:
VITE_FORMSPREE_ENDPOINT=

# Option B: Supabase (already supported by this project). Enable Supabase,
# create a `contact_messages` table, and set:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
